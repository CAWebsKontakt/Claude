# =====================================================================
# TwitchClip AI – Konfiguration
# =====================================================================
# 1. Kopieren:            cp .env.example .env && chmod 600 .env
# 2. Geheimnisse erzeugen: docker compose run --rm --no-deps migrate python -m app.cli generate-secrets
#    (oder lokal: python3 -c "import secrets;print(secrets.token_urlsafe(48))")
# 3. Alle Werte mit CHANGE_ME ersetzen. Die .env NIEMALS in Git einchecken.
# =====================================================================

# --- Allgemein --------------------------------------------------------
APP_ENV=production
# Öffentliche Adresse des Dashboards (muss mit https:// beginnen)
APP_BASE_URL=https://clips.example.com
# Domain für Caddy/Let's Encrypt (DNS-A-Record muss auf den VPS zeigen)
DOMAIN=clips.example.com
ACME_EMAIL=admin@example.com
TIMEZONE=Europe/Berlin
LOG_LEVEL=INFO

# --- Sicherheit (alle Pflicht!) --------------------------------------
# Signiert Session-Cookies. Mind. 32 zufällige Zeichen.
SECRET_KEY=CHANGE_ME
# Fernet-Schlüssel für OAuth-Tokens in der Datenbank. Mehrere kommagetrennt = Rotation.
TOKEN_ENCRYPTION_KEY=CHANGE_ME
SESSION_MAX_AGE_HOURS=12
SESSION_COOKIE_SECURE=true
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=900

# --- Datenbank & Redis (werden von docker-compose verwendet) ---------
POSTGRES_USER=twitchclip
POSTGRES_DB=twitchclip
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
# DATABASE_URL und REDIS_URL setzt docker-compose.yml automatisch.

# --- Fachliche Einstellungen -----------------------------------------
# Kommagetrennte Twitch-Logins. Werden beim Start einmalig als Modus A angelegt;
# danach ist das Dashboard die maßgebliche Liste (es wird nie etwas automatisch entfernt).
STREAMER_LIST=
# Höchstzahl neuer Highlights pro Kalendertag (Europe/Berlin)
MAX_CLIPS_PER_DAY=10
# Highlights unter dieser Bewertung (0–100) werden nicht vorgeschlagen
MIN_HIGHLIGHT_SCORE=60
# de | en | auto
CLIP_LANGUAGE=de
# Bevorzugte Cliplänge in Sekunden (Twitch-VOD-Clips: max. 60)
CLIP_DURATION_MIN=20
CLIP_DURATION_MAX=45
# Anzahl ausgewählter Kandidaten je Stream
HIGHLIGHTS_PER_STREAM_MIN=3
HIGHLIGHTS_PER_STREAM_MAX=5
# Videodateien (Downloads, Renderings, Exporte) nach X Tagen löschen
STORAGE_RETENTION_DAYS=7
# Harte Obergrenze für Mediendaten in GB
STORAGE_MAX_GB=20
ACTIVITY_RETENTION_DAYS=90

# --- Twitch (ab Phase 2) ---------------------------------------------
# https://dev.twitch.tv/console/apps – OAuth-Redirect: ${APP_BASE_URL}/oauth/twitch/callback
# Bitte eine eigene Twitch-App nur für TwitchClip AI verwenden (EventSub-Abgleich verwaltet alle
# stream.online/offline-Abos dieser Client-ID).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Zufälliger Wert (10–100 Zeichen) zur Signaturprüfung der EventSub-Webhooks
TWITCH_EVENTSUB_SECRET=CHANGE_ME
# EventSub-Webhooks nutzen (benötigt APP_BASE_URL mit https:// auf Port 443). false = nur Polling.
TWITCH_EVENTSUB_ENABLED=true
# Abgleich des Live-Status per API (Rückfallebene zu EventSub), 60–3600 s
TWITCH_POLL_INTERVAL_SECONDS=180
# Öffentliche Clips: wie oft suchen, wie weit zurück, wie lange speichern (nur Metadaten)
CLIP_DISCOVERY_INTERVAL_MINUTES=30
CLIP_DISCOVERY_LOOKBACK_HOURS=48
CLIP_RETENTION_DAYS=30

# --- Modus B: autorisierte Verarbeitung (ab Phase 3) -----------------
# Gültigkeit der Autorisierungslinks für Streamer/Editoren (Tage)
TWITCH_INVITE_VALID_DAYS=7
# Höchstzahl automatisch übernommener Clip-Kandidaten je Stream
CLIP_CANDIDATES_PER_STREAM=8
# Größte erlaubte Clip-Datei beim Download (MB)
CLIP_DOWNLOAD_MAX_MB=500
# Pfade der neueren Twitch-Clip-Endpunkte – nur ändern, falls die offizielle Referenz abweicht
TWITCH_VOD_CLIP_PATH=/videos/clips
TWITCH_CLIP_DOWNLOAD_PATH=/clips/downloads

# --- TikTok (ab Phase 6) ---------------------------------------------
# https://developers.tiktok.com – Redirect: ${APP_BASE_URL}/oauth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Erst auf true setzen, wenn TikTok die App für Direct Post auditiert hat.
# Bis dahin: Upload als Entwurf in die TikTok-Inbox oder manueller Export.
TIKTOK_DIRECT_POST_ENABLED=false

# --- KI / Medien (ab Phase 4) ----------------------------------------
# tiny | base | small | medium | large-v3  (small = guter Kompromiss auf CPU)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Spracherkennung abschalten (sehr kleine Server): dann zählen nur Ton, Bild, Chat und Zuschauer-Signale
ANALYSIS_TRANSCRIPTION=true
# Chat-Statistik (nur Zählwerte) für Streamer, die beim Autorisieren die Chat-Scopes erlaubt haben
CHAT_STATS_ENABLED=true
# Chat-Spitze = so viel mal mehr Aktivität als üblich → zusätzlicher Clip-Kandidat aus dem VOD
CHAT_SPIKE_FACTOR=2.5
# Duplikate: maximaler Unterschied der Bild-Hashes (0 = identisch, 64 = völlig verschieden)
DUPLICATE_HASH_DISTANCE=10

# --- Videoschnitt (ab Phase 5) ---------------------------------------
# x264-Preset: veryfast (schnell, größere Datei) … medium (Standard) … slow (klein, langsam)
RENDER_PRESET=medium
# Qualität 14 (sehr hoch) … 30 (niedrig); 20 ist für 1080×1920 ein guter Wert
RENDER_CRF=20
# Untertitel einbrennen; GROSSBUCHSTABEN-Stil optional
SUBTITLES_ENABLED=true
SUBTITLES_UPPERCASE=false
# Ressourcen des Medien-Workers (an VPS-Größe anpassen)
MEDIA_WORKER_MEMORY=3g
MEDIA_WORKER_CPUS=2.0

# --- Testmodus --------------------------------------------------------
# true = verarbeitet nur Beispieldateien aus /data/samples, keine externen API-Aufrufe
TEST_MODE=false
